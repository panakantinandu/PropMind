<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="{{csrfToken}}">
  <title>Admin Support Center - LeaseHub</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #f5f7fa;
      --surface: #ffffff;
      --surface2: #f8fafc;
      --border: #e5e7eb;
      --accent: #4a90e2;
      --accent2: #60a5fa;
      --green: #10b981;
      --red: #ef4444;
      --amber: #f59e0b;
      --text: #111827;
      --text2: #4b5563;
      --text3: #6b7280;
      --font: 'DM Sans', sans-serif;
    }

    body { font-family: var(--font); background: var(--bg); color: var(--text); min-height: 100vh; }

    nav {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 0 1.5rem;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 4px 18px rgba(15,23,42,.12);
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .nav-brand { font-size: 15px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .nav-badge { font-size: 10px; padding: 2px 7px; border-radius: 99px; background: rgba(255,255,255,.18); color: rgba(255,255,255,.9); border: 1px solid rgba(255,255,255,.22); }
    .nav-links { display: flex; gap: 6px; }
    .nav-links a { font-size: 13px; color: rgba(255,255,255,.9); text-decoration: none; padding: 6px 12px; border-radius: 10px; transition: background .15s, color .15s; }
    .nav-links a:hover, .nav-links a.active { background: rgba(255,255,255,.18); color: #fff; }
    .nav-right { display: flex; align-items: center; gap: 10px; font-size: 12px; color: rgba(255,255,255,.88); }

    .layout { max-width: 1400px; margin: 24px auto 40px; display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 24px; padding: 0 16px 20px; }

    .sidebar-left { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; display: flex; flex-direction: column; overflow: hidden; }
    .sidebar-left::-webkit-scrollbar { width: 6px; }
    .sidebar-left::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }

    .sl-section { padding: 20px; }
    .sl-title { font-size: 12px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; color: var(--text3); margin-bottom: 18px; }

    .cmd-item { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 14px; cursor: pointer; transition: background .15s, transform .15s; margin-bottom: 10px; background: var(--surface2); border: 1px solid var(--border); }
    .cmd-item:hover { background: #eef2ff; transform: translateY(-1px); }
    .cmd-icon { font-size: 16px; width: 24px; text-align: center; flex-shrink: 0; }
    .cmd-text { font-size: 13px; color: var(--text2); }
    .cmd-item:hover .cmd-text { color: var(--text); }

    .divider { height: 1px; background: var(--border); margin: 0 20px; }

    .chat-main { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; display: flex; flex-direction: column; overflow: hidden; }

    .chat-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 14px; }
    .ai-icon { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .chat-header-info { flex: 1; }
    .chat-header-name { font-size: 16px; font-weight: 700; color: var(--text); }
    .chat-header-sub { font-size: 13px; color: var(--text3); display: flex; align-items: center; gap: 8px; }
    .chat-header-sub::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--green); display: inline-block; }
    .header-stats { display: flex; gap: 12px; }
    .hstat { text-align: center; }
    .hstat-num { font-size: 16px; font-weight: 600; color: var(--text); }
    .hstat-label { font-size: 10px; color: var(--text3); }
    .btn-clear { padding: .5rem .9rem; border-radius: 12px; border: 1px solid var(--border); background: var(--surface2); color: var(--text2); font-size: 12px; cursor: pointer; transition: all .15s; }
    .btn-clear:hover { background: #eef2ff; color: var(--text); }

    .messages { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 18px; background: var(--surface2); }
    .messages::-webkit-scrollbar { width: 6px; }
    .messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }

    .welcome { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 16px; padding: 28px; }
    .welcome-title { font-size: 22px; font-weight: 700; }
    .welcome-sub { font-size: 14px; color: var(--text3); max-width: 420px; line-height: 1.7; }
    .welcome-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: .75rem; width: 100%; max-width: 500px; }
    .wcard { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px; text-align: left; cursor: pointer; transition: border-color .15s, background .15s; }
    .wcard:hover { border-color: var(--accent); background: #eff6ff; }
    .wcard-icon { font-size: 18px; margin-bottom: 8px; }
    .wcard-title { font-size: 14px; font-weight: 600; color: var(--text); }
    .wcard-sub { font-size: 12px; color: var(--text3); margin-top: 3px; }

    .msg { display: flex; gap: 10px; align-items: flex-start; max-width: 80%; }
    .msg.user { align-self: flex-end; flex-direction: row-reverse; }
    .msg.ai { align-self: flex-start; }
    .msg-avatar { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; }
    .msg.ai .msg-avatar { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; }
    .msg.user .msg-avatar { background: var(--surface2); border: 1px solid var(--border); color: var(--text2); }
    .msg-inner { flex: 1; }
    .msg-bubble { padding: .95rem 1rem; border-radius: 18px; font-size: 14px; line-height: 1.6; }
    .msg.ai .msg-bubble { background: #ffffff; border: 1px solid var(--border); }
    .msg.user .msg-bubble { background: #eff6ff; border: 1px solid #dbeafe; }
    .msg-time { font-size: 10px; color: var(--text3); margin-top: 6px; }
    .msg.user .msg-time { text-align: right; }

    .data-table { width: 100%; border-collapse: collapse; margin-top: .75rem; font-size: 12px; }
    .data-table th { text-align: left; padding: .4rem .6rem; color: var(--text3); font-weight: 500; border-bottom: 1px solid var(--border); }
    .data-table td { padding: .4rem .6rem; border-bottom: 1px solid rgba(37,45,66,.2); }
    .data-table tr:last-child td { border-bottom: none; }

    .stat-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: .75rem; }
    .stat-chip { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: .5rem .75rem; }
    .stat-chip .sc-val { font-size: 18px; font-weight: 600; }
    .stat-chip .sc-label { font-size: 11px; color: var(--text3); margin-top: 1px; }
    .stat-chip.red .sc-val { color: var(--red); }
    .stat-chip.green .sc-val { color: var(--green); }
    .stat-chip.amber .sc-val { color: var(--amber); }
    .stat-chip.blue .sc-val { color: var(--accent2); }

    .suggestions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: .75rem; }
    .sugg-btn { font-size: 12px; padding: 7px 12px; border-radius: 10px; border: 1px solid var(--border); color: var(--text2); background: var(--surface); cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
    .sugg-btn:hover { border-color: var(--accent); color: var(--accent2); background: #eef2ff; }

    .typing-indicator { display: flex; gap: 4px; align-items: center; }
    .typing-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text3); animation: bounce 1.2s infinite; }
    .typing-dot:nth-child(2) { animation-delay: .2s; }
    .typing-dot:nth-child(3) { animation-delay: .4s; }
    @keyframes bounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }

    .input-area { padding: 20px 24px 24px; border-top: 1px solid var(--border); }
    .input-wrapper { display: flex; gap: 10px; align-items: flex-end; background: #ffffff; border: 1px solid var(--border); border-radius: 16px; padding: 12px 14px; }
    .input-wrapper:focus-within { border-color: var(--accent); }
    #chat-input { flex: 1; background: none; border: none; outline: none; color: var(--text); font-size: 14px; font-family: var(--font); resize: none; max-height: 100px; line-height: 1.5; min-height: 24px; }
    #chat-input::placeholder { color: var(--text3); }
    .send-btn { width: 38px; height: 38px; border-radius: 12px; background: var(--accent); border: none; color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: opacity .15s; }
    .send-btn:hover { opacity: .92; }
    .send-btn:disabled { opacity: .35; cursor: not-allowed; }
    .input-hint { font-size: 12px; color: var(--text3); margin-top: 10px; }

    .toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #ffffff; border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; font-size: 13px; color: var(--text); transform: translateY(20px); opacity: 0; transition: all .3s; z-index: 200; }
    .toast.show { transform: translateY(0); opacity: 1; }
  </style>
</head>
<body>

<nav>
  <a href="/admin/dashboard" class="nav-brand">⬡ LeaseHub <span class="nav-badge">Admin</span></a>
  <div class="nav-links">
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/tenants">Tenants</a>
    <a href="/admin/properties">Properties</a>
    <a href="/admin/payments">Payments</a>
    <a href="/admin/maintenance">Maintenance</a>
    <a href="/admin/support" class="active">Support AI</a>
  </div>
  <div class="nav-right">
    <span>{{adminName}}</span>
    <a href="/admin/logout" style="color:var(--text3);text-decoration:none;font-size:12px;">Sign out</a>
  </div>
</nav>

<div class="layout">

  <!-- LEFT SIDEBAR -->
  <aside class="sidebar-left">
    <div class="sl-section">
      <div class="sl-title">Portfolio queries</div>
      <div class="cmd-item" data-q="Give me a full portfolio summary for today"><span class="cmd-icon">📊</span><span class="cmd-text">Portfolio summary</span></div>
      <div class="cmd-item" data-q="Show all unpaid and overdue invoices"><span class="cmd-icon">💸</span><span class="cmd-text">Unpaid invoices</span></div>
      <div class="cmd-item" data-q="Which tenants are most at risk of defaulting?"><span class="cmd-icon">⚠️</span><span class="cmd-text">At-risk tenants</span></div>
      <div class="cmd-item" data-q="Show me all pending applications and their risk scores"><span class="cmd-icon">📝</span><span class="cmd-text">Pending applications</span></div>
      <div class="cmd-item" data-q="What is my total rent collected this month?"><span class="cmd-icon">💰</span><span class="cmd-text">Revenue this month</span></div>
    </div>
    <div class="divider"></div>
    <div class="sl-section">
      <div class="sl-title">Operations</div>
      <div class="cmd-item" data-q="Show all open maintenance tickets and their priority"><span class="cmd-icon">🔧</span><span class="cmd-text">Open maintenance</span></div>
      <div class="cmd-item" data-q="Which leases are expiring in the next 60 days?"><span class="cmd-icon">📋</span><span class="cmd-text">Expiring leases</span></div>
      <div class="cmd-item" data-q="Which properties have been vacant the longest?"><span class="cmd-icon">🏢</span><span class="cmd-text">Vacant properties</span></div>
      <div class="cmd-item" data-q="Show me all tenant support tickets that need my attention"><span class="cmd-icon">🎫</span><span class="cmd-text">Support tickets</span></div>
    </div>
    <div class="divider"></div>
    <div class="sl-section">
      <div class="sl-title">Insights</div>
      <div class="cmd-item" data-q="What should I prioritise doing today?"><span class="cmd-icon">🎯</span><span class="cmd-text">Today's priorities</span></div>
      <div class="cmd-item" data-q="Are there any anomalies or issues I should be aware of?"><span class="cmd-icon">🔍</span><span class="cmd-text">Anomaly detection</span></div>
      <div class="cmd-item" data-q="Which tenants have not paid rent for more than 30 days?"><span class="cmd-icon">🚨</span><span class="cmd-text">Late payments</span></div>
      <div class="cmd-item" data-q="Recommend actions to improve collection rate"><span class="cmd-icon">📈</span><span class="cmd-text">Improve collections</span></div>
    </div>
  </aside>

  <!-- CHAT -->
  <div class="chat-main">
    <div class="chat-header">
      <div class="ai-icon">🤖</div>
      <div class="chat-header-info">
        <div class="chat-header-name">Portfolio Intelligence</div>
        <div class="chat-header-sub">Connected to live data · Responds instantly</div>
      </div>
      <button class="btn-clear" id="clear-chat">Clear chat</button>
    </div>

    <div class="messages" id="messages">
      <div class="welcome" id="welcome">
        <div style="font-size:40px">⬡</div>
        <div class="welcome-title">Good day, {{adminName}}</div>
        <div class="welcome-sub">Ask me anything about your portfolio — tenant risk, unpaid invoices, maintenance, or what to prioritise today. I have live access to all your data.</div>
        <div class="welcome-grid">
          <div class="wcard" data-q="Give me a full portfolio summary for today">
            <div class="wcard-icon">📊</div>
            <div class="wcard-title">Portfolio summary</div>
            <div class="wcard-sub">Overview of all key metrics</div>
          </div>
          <div class="wcard" data-q="Which tenants are most at risk of defaulting?">
            <div class="wcard-icon">⚠️</div>
            <div class="wcard-title">Risk assessment</div>
            <div class="wcard-sub">Tenants flagged for default risk</div>
          </div>
          <div class="wcard" data-q="What should I prioritise doing today?">
            <div class="wcard-icon">🎯</div>
            <div class="wcard-title">Today's priorities</div>
            <div class="wcard-sub">AI-ranked action list</div>
          </div>
          <div class="wcard" data-q="Show all unpaid and overdue invoices">
            <div class="wcard-icon">💸</div>
            <div class="wcard-title">Unpaid invoices</div>
            <div class="wcard-sub">Overdue and outstanding</div>
          </div>
        </div>
      </div>
    </div>

    <div class="input-area">
      <div class="input-wrapper">
        <textarea id="chat-input" placeholder="Ask about your portfolio, tenants, payments, maintenance…" rows="1"></textarea>
        <button class="send-btn" id="send-btn" disabled>➤</button>
      </div>
      <div class="input-hint">Answers are grounded in your live data · No hallucination</div>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script nonce="{{cspNonce}}">
  const CSRF_TOKEN = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const messagesEl = document.getElementById('messages');
  const welcomeEl = document.getElementById('welcome');
  const inputEl = document.getElementById('chat-input');
  const sendBtn = document.getElementById('send-btn');
  let isTyping = false;

  // Auto-resize textarea
  inputEl.addEventListener('input', () => {
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 100) + 'px';
    sendBtn.disabled = !inputEl.value.trim();
  });

  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (inputEl.value.trim() && !isTyping) sendMessage(inputEl.value.trim());
    }
  });

  sendBtn.addEventListener('click', () => {
    if (inputEl.value.trim() && !isTyping) sendMessage(inputEl.value.trim());
  });

  // Quick action items
  document.querySelectorAll('.cmd-item, .wcard').forEach(el => {
    el.addEventListener('click', () => {
      const q = el.dataset.q;
      if (q) sendMessage(q);
    });
  });

  // Clear
  document.getElementById('clear-chat').addEventListener('click', () => {
    messagesEl.innerHTML = '';
    messagesEl.appendChild(welcomeEl);
    welcomeEl.style.display = 'flex';
    showToast('Chat cleared');
  });

  function timeStr() {
    return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function escapeHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function addUserMessage(text) {
    welcomeEl.style.display = 'none';
    const wrap = document.createElement('div');
    wrap.className = 'msg user';
    wrap.innerHTML = `
      <div class="msg-avatar">A</div>
      <div class="msg-inner">
        <div class="msg-bubble">${escapeHtml(text)}</div>
        <div class="msg-time">${timeStr()}</div>
      </div>`;
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addAIMessage(content, suggestions, rawData) {
    const wrap = document.createElement('div');
    wrap.className = 'msg ai';

    let bubbleContent = '';

    // Main answer text
    const answerText = (typeof content === 'string' ? content : JSON.stringify(content, null, 2))
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');
    bubbleContent += answerText;

    // If there are stat chips (numbers in data)
    if (rawData?.stats) {
      bubbleContent += '<div class="stat-row">';
      rawData.stats.forEach(s => {
        bubbleContent += `<div class="stat-chip ${s.color || ''}"><div class="sc-val">${escapeHtml(String(s.value))}</div><div class="sc-label">${escapeHtml(s.label)}</div></div>`;
      });
      bubbleContent += '</div>';
    }

    wrap.innerHTML = `
      <div class="msg-avatar">⬡</div>
      <div class="msg-inner">
        <div class="msg-bubble">${bubbleContent}</div>
        ${suggestions?.length ? `<div class="suggestions">${suggestions.map(s => `<button class="sugg-btn" data-q="${escapeHtml(s)}">${escapeHtml(s)}</button>`).join('')}</div>` : ''}
        <div class="msg-time">${timeStr()}</div>
      </div>`;

    // Wire suggestion buttons
    wrap.querySelectorAll('.sugg-btn').forEach(btn => {
      btn.addEventListener('click', () => sendMessage(btn.dataset.q));
    });

    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function showTyping() {
    const wrap = document.createElement('div');
    wrap.id = 'typing-msg';
    wrap.className = 'msg ai';
    wrap.innerHTML = `
      <div class="msg-avatar">⬡</div>
      <div class="msg-bubble" style="padding:.75rem 1rem">
        <div class="typing-indicator">
          <div class="typing-dot"></div>
          <div class="typing-dot"></div>
          <div class="typing-dot"></div>
        </div>
      </div>`;
    messagesEl.appendChild(wrap);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function removeTyping() {
    document.getElementById('typing-msg')?.remove();
  }

  async function sendMessage(text) {
    if (isTyping) return;
    isTyping = true;
    sendBtn.disabled = true;

    addUserMessage(text);
    inputEl.value = '';
    inputEl.style.height = 'auto';
    showTyping();

    try {
      const res = await fetch('/admin/support/ask', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-Token': CSRF_TOKEN
        },
        body: JSON.stringify({ question: text, _csrf: CSRF_TOKEN })
      });

      removeTyping();

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        if (res.status === 429) {
          addAIMessage('You\'ve reached the rate limit for AI queries. Please wait a moment before asking again.', []);
        } else {
          addAIMessage('Something went wrong on my end. Please try again.', ['Try again', 'Refresh the page']);
        }
        return;
      }

      const data = await res.json();
      const result = data?.result || {};
      const parsed = result.parsed || data?.parsed || {};
      const answer = parsed.answer || result.raw || data?.raw || 'I wasn\'t able to get a clear answer. Try rephrasing your question.';
      const suggestions = parsed.suggestions || getFollowUps(text);

      addAIMessage(answer, suggestions, result.stats || parsed.stats || null);

    } catch (err) {
      removeTyping();
      addAIMessage('Connection error. Please check your network and try again.', ['Try again']);
    }

    isTyping = false;
    sendBtn.disabled = !inputEl.value.trim();
  }

  function getFollowUps(q) {
    q = q.toLowerCase();
    if (q.includes('invoice') || q.includes('payment')) return ['Which tenants are most overdue?', 'Send reminder to overdue tenants', 'Show payment trends'];
    if (q.includes('application') || q.includes('applicant')) return ['Show high-risk applications', 'What is the average approval time?'];
    if (q.includes('maintenance') || q.includes('ticket')) return ['Which tickets are most urgent?', 'Show overdue maintenance'];
    if (q.includes('lease') || q.includes('expir')) return ['Draft renewal reminders', 'Which tenants are likely to renew?'];
    return ['Today\'s priorities', 'Portfolio summary', 'Show anomalies'];
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast show';
    setTimeout(() => t.className = 'toast', 2500);
  }
</script>
</body>
</html>
